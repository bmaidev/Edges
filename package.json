{
  "name": "edges-v2",
  "version": "0.2.0",
  "private": true,
  "description": "A calm, privacy-first, multi-room facilitation platform. Named facilitation methods are configured chains of a few irreducible interaction primitives.",
  "license": "MIT",
  "author": "Black Mountain AI",
  "homepage": "https://github.com/bmaidev/Edges#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bmaidev/Edges.git"
  },
  "bugs": {
    "url": "https://github.com/bmaidev/Edges/issues"
  },
  "keywords": [
    "facilitation",
    "workshop",
    "nextjs",
    "real-time",
    "privacy",
    "ai",
    "anthropic"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "load:smoke": "node scripts/load-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run audit:prod"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@vercel/blob": "^2.8.0",
    "@vercel/kv": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.22",
    "pdfjs-dist": "^4.10.38",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.6.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.22",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.18",
      "sharp": "0.35.3"
    }
  }
